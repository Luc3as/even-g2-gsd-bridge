{
  "name": "even-g2-gsd-bridge",
  "version": "0.1.0",
  "type": "module",
  "description": "Host-side bridge: view & steer live GSD-PI coding agents (running in tmux) from Even Realities G2 glasses over the even-terminal HTTP/SSE protocol. Attach-to-live via tmux + gsd-native jsonl.",
  "license": "MIT",
  "bin": {
    "even-g2-gsd-bridge": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
