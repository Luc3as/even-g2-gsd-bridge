# Copy to .env (chmod 600). All optional — safe defaults exist.
# Fixed token so the glasses never need re-pairing/re-scan across restarts.
BRIDGE_TOKEN=change-me-to-a-long-random-hex
# Port the Even App connects to (Even ecosystem default).
PORT=3456
# Bind address. 0.0.0.0 = reachable over the WG-routed LAN from the phone.
BIND_HOST=0.0.0.0
# Where gsd writes per-project transcripts.
GSD_SESSIONS_DIR=/home/lukas/.gsd/agent/sessions
# Comma-separated roots; only projects under these are exposed.
PROJECT_ROOTS=/opt/AI_projects
# If a project has no live tmux session, spawn one and launch this on prompt.
ALLOW_SPAWN=true
SPAWN_COMMAND=gsd
# gsd TUI keystrokes (tmux send-keys names). Calibrate against the live TUI.
KEY_PERMISSION_ALLOW=Enter
KEY_PERMISSION_DENY=Escape
KEY_INTERRUPT=Escape
